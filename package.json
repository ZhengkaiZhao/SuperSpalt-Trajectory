{
    "name": "supersplat",
    "version": "2.32.7",
    "author": "PlayCanvas<support@playcanvas.com>",
    "homepage": "https://playcanvas.com/supersplat/editor",
    "description": "3D Gaussian Splat Editor",
    "keywords": [
        "playcanvas",
        "ply",
        "gaussian",
        "splat",
        "editor"
    ],
    "license": "MIT",
    "main": "index.js",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w",
        "serve": "serve dist -C",
        "app:start": "node scripts/start-local.mjs",
        "app:start:rebuild": "node scripts/start-local.mjs --rebuild",
        "release:zip": "node scripts/package-source.mjs",
        "develop": "cross-env BUILD_TYPE=debug concurrently --kill-others \"npm run watch\" \"npm run serve\"",
        "develop:auto-launch": "concurrently --kill-others \"xdg-open 'http://localhost:3000/'\" \"npm run watch\" \"npm run serve\"",
        "test": "node scripts/test-core-logic.mjs",
        "check": "npm run lint && npm run lint:locales && npm test && tsc --noEmit",
        "lint": "eslint src",
        "lint:locales": "node scripts/check-locales.mjs"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "devDependencies": {
        "@babylonjs/core": "^9.20.0",
        "@playcanvas/eslint-config": "2.1.0",
        "@playcanvas/pcui": "6.1.4",
        "@playcanvas/splat-transform": "3.1.7",
        "@rollup/plugin-alias": "6.0.0",
        "@rollup/plugin-image": "3.0.3",
        "@rollup/plugin-json": "6.1.0",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@rollup/plugin-strip": "3.0.4",
        "@rollup/plugin-terser": "1.0.0",
        "@rollup/plugin-typescript": "12.3.0",
        "@types/archiver": "^8.0.0",
        "@types/wicg-file-system-access": "2023.10.7",
        "@typescript-eslint/eslint-plugin": "8.65.0",
        "@typescript-eslint/parser": "8.65.0",
        "@webgpu/glslang": "^0.0.15",
        "archiver": "^8.0.0",
        "autoprefixer": "10.5.4",
        "concurrently": "10.0.4",
        "cors": "2.8.6",
        "cross-env": "10.1.0",
        "eslint": "9.39.5",
        "eslint-import-resolver-typescript": "4.4.5",
        "globals": "17.7.0",
        "i18next": "26.3.6",
        "i18next-browser-languagedetector": "8.2.1",
        "i18next-http-backend": "4.0.0",
        "mediabunny": "1.51.0",
        "playcanvas": "2.21.1",
        "postcss": "8.5.23",
        "rollup": "4.62.2",
        "rollup-plugin-scss": "4.0.1",
        "sass": "1.102.0",
        "serve": "14.2.6",
        "tslib": "2.8.1",
        "typescript": "6.0.3"
    }
}
